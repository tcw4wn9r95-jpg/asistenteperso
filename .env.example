# Copy to .env and fill in.

# SQLite for local dev (zero-infra). For production use Postgres, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/asistenteperso"
DATABASE_URL="file:./dev.db"

# Anthropic Claude API key. Required for milestone plan generation and the Claudio chatbot.
# Without it, the app still runs; AI features fall back to deterministic stubs.
ANTHROPIC_API_KEY=""

# Model overrides (optional)
PLAN_MODEL="claude-opus-4-8"
CHAT_MODEL="claude-sonnet-4-6"
