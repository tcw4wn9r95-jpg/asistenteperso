# This is a zero-backend static PWA — it needs no secrets to run.
# Integrations read public JSON from your other repos (training-ai, nutriprep).

# Optional: base path when deploying to a GitHub Pages *project* site
# (https://<user>.github.io/asistenteperso). The deploy workflow sets this.
# Leave unset for local dev or a root/custom-domain deploy.
# NEXT_PUBLIC_BASE_PATH="/asistenteperso"

# Optional: a Claude-backed endpoint (serverless function or Action proxy) that
# powers the Claudio chatbot. The rest of the app works without it.
# NEXT_PUBLIC_CHAT_ENDPOINT="https://your-worker.example.com/chat"

# Optional: override where integration JSON is read from (default raw.githubusercontent).
# INTEGRATION_BASE / INTEGRATION_OWNER / INTEGRATION_BRANCH
