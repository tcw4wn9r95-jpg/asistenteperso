// Personal time-management assistant — data model.
//
// Dev uses SQLite (zero-infra). For production switch `provider` to "postgresql"
// and the schema migrates cleanly; the only SQLite-specific choices here are:
//   - enum-like values stored as String (allowed values documented inline)
//   - array/structured fields stored as Json
// Both are forward-compatible with Postgres (where you may later promote them
// to native enums / jsonb / arrays).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Single-user-ish app: one User row, but every table keeps a userId FK so a
// second account (e.g. a co-parent) is additive, not a rewrite.
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  timezone           String   @default("UTC")
  // jsonb: { wake: "07:00", sleep: "23:00" }
  dayBounds          Json
  // jsonb: per-weekday free windows + energy tags, e.g.
  // { "1": [{ start: "09:00", end: "12:00", energy: "HIGH" }], ... } (1=Mon)
  weeklyAvailability Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  milestones       Milestone[]
  tasks            Task[]
  recurrences      Recurrence[]
  dayPlans         DayPlan[]
  integrationItems IntegrationItem[]
  streaks          Streak[]
  checkIns         CheckIn[]
  chatMessages     ChatMessage[]
}

// A big goal with a deadline (e.g. "pass B2 Spanish exam").
// domain: LANGUAGE_EXAM | FITNESS | GENERIC
model Milestone {
  id         String   @id @default(cuid())
  userId     String
  title      String
  domain     String
  targetDate DateTime
  // jsonb: free-form context, e.g. { currentLevel: "B1", target: "B2", weakAreas: ["listening"] }
  details    Json
  status     String   @default("ACTIVE") // ACTIVE | DONE | ARCHIVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan?
}

// The generated, phased plan for a Milestone.
model Plan {
  id               String   @id @default(cuid())
  userId           String
  milestoneId      String   @unique
  playbookKey      String
  weeklyHoursBudget Float
  generatedByModel String?
  rationale        String?
  status           String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  milestone Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  phases    PlanPhase[]
}

model PlanPhase {
  id        String   @id @default(cuid())
  planId    String
  order     Int
  name      String
  startDate DateTime
  endDate   DateTime
  // jsonb: { objectives: string[], weeklyTaskTemplates: TaskTemplate[] }
  objectives          Json
  weeklyTaskTemplates Json
  createdAt DateTime @default(now())

  plan  Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks Task[]
}

// Codified expert methodology per domain. Seeded, not user-created.
model ExpertPlaybook {
  id            String   @id @default(cuid())
  domain        String   @unique // LANGUAGE_EXAM | FITNESS | GENERIC
  key           String   @unique
  version       Int      @default(1)
  // jsonb: ordered phases as timeline proportions + focus areas
  phaseSkeleton  Json
  // jsonb: reusable task archetypes
  taskArchetypes Json
  groundingPrompt String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// The flexible unit of work. Covers generic tasks, chores, study, integration-derived.
// kind: GENERIC | CHORE | STUDY | INTEGRATION_DERIVED
// priority: 1 (highest) .. 4 (lowest)
// estimateSource: USER | APP_SUGGESTED
// preferredTimeOfDay: MORNING | MIDDAY | EVENING | ANY
// energy: LOW | MED | HIGH
model Task {
  id                String   @id @default(cuid())
  userId            String
  title             String
  notes             String?
  kind              String   @default("GENERIC")
  priority          Int      @default(3)
  estimatedMinutes  Int
  estimateSource    String   @default("APP_SUGGESTED")
  preferredTimeOfDay String  @default("ANY")
  energy            String   @default("MED")
  dueDate           DateTime?
  status            String   @default("PENDING") // PENDING | SCHEDULED | DONE | SKIPPED
  planPhaseId       String?
  recurrenceId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planPhase  PlanPhase?    @relation(fields: [planPhaseId], references: [id], onDelete: SetNull)
  recurrence Recurrence?   @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  segments   TaskSegment[]
  blocks     ScheduleBlock[]
}

// Models multi-stage tasks with passive gaps: laundry = ACTIVE(load) -> PASSIVE(dry) -> ACTIVE(fold).
// type: ACTIVE | PASSIVE
model TaskSegment {
  id                  String  @id @default(cuid())
  taskId              String
  order               Int
  type                String
  label               String
  minutes             Int
  requiresUserPresence Boolean @default(true)

  task   Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  blocks ScheduleBlock[]
}

// Recurrence rule owning recurring tasks (chores, study cadence).
// freq: DAILY | WEEKLY | MONTHLY
model Recurrence {
  id        String   @id @default(cuid())
  userId    String
  freq      String
  interval  Int      @default(1)
  // jsonb int[] of weekdays (1=Mon..7=Sun) for WEEKLY
  byWeekday Json?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
}

// One generated day. The approval-gate record.
// status: PENDING | APPROVED | MODIFIED
model DayPlan {
  id          String   @id @default(cuid())
  userId      String
  date        String   // ISO date (yyyy-MM-dd) in the user's timezone
  status      String   @default("PENDING")
  generatedAt DateTime @default(now())
  approvedAt  DateTime?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks ScheduleBlock[]

  @@unique([userId, date])
}

// The atomic unit on the timeline.
// kind: ACTIVE_WORK | PASSIVE_WAIT | FIXED | INTEGRATION
// source: AUTO | USER | AI
model ScheduleBlock {
  id                String   @id @default(cuid())
  dayPlanId         String
  taskId            String?
  taskSegmentId     String?
  integrationItemId String?
  start             DateTime
  end               DateTime
  kind              String
  locked            Boolean  @default(false)
  source            String   @default("AUTO")
  createdAt         DateTime @default(now())

  dayPlan         DayPlan          @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskSegment     TaskSegment?     @relation(fields: [taskSegmentId], references: [id], onDelete: SetNull)
  integrationItem IntegrationItem? @relation(fields: [integrationItemId], references: [id], onDelete: SetNull)
  checkIn         CheckIn?
}

// Produced by integration adapters (Coach Claudio, NutriPrep), consumed by scheduler.
// provider: COACH_CLAUDIO | NUTRIPREP
model IntegrationItem {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  externalId        String
  date              String   // yyyy-MM-dd
  title             String
  suggestedMinutes  Int
  preferredTimeOfDay String  @default("ANY")
  energy            String   @default("MED")
  payload           Json
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks ScheduleBlock[]

  @@unique([userId, provider, externalId, date])
}

// Adaptive accountability. key e.g. "domain:language-exam" or "chore:laundry".
model Streak {
  id                String   @id @default(cuid())
  userId            String
  key               String
  current           Int      @default(0)
  longest           Int      @default(0)
  lastCompletedDate String?
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// outcome: DONE | SKIPPED | PARTIAL
model CheckIn {
  id                     String   @id @default(cuid())
  userId                 String
  scheduleBlockId        String   @unique
  outcome                String
  implementationIntention String?
  note                   String?
  createdAt              DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleBlock ScheduleBlock @relation(fields: [scheduleBlockId], references: [id], onDelete: Cascade)
}

// Claudio chat history (incl. tool_use / tool_result blocks).
// role: USER | ASSISTANT | TOOL
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  role      String
  // jsonb: text + tool_use/tool_result content blocks
  content   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
